import Foundation

enum RealBackend: FormatBackend {
    static var backendName: String { "codeformat.v1 (CodeFormatEngine + bundled manifests)" }

    static func detect(_ text: String) -> (languageID: String, confidence: Double, rule: String) {
        let result = SyntaxLexer.detect(text)
        return (result.language.manifestIdentifier.isEmpty ? "plain" : result.language.manifestIdentifier,
                result.confidence, "score-based")
    }

    static func format(_ text: String, languageID: String) throws -> String? {
        // RealBackend is intentionally identical to StubBackend now that
        // CodeFormatting.swift is integrated. The only reason this file
        // exists is to flip backendName and add post-conditions (e.g.
        // verifying bundled executables are signed / present).
        guard let langID = CodeLanguage.allCases.first(where: { $0.manifestIdentifier == languageID }) else {
            return nil
        }
        do {
            return try CodeFormatEngine.format(text, language: langID, indent: "  ")
        } catch let e as FormatError {
            if case .noEngineAvailable = e { return nil }
            if case .engineNotFound = e { return nil }
            throw e
        }
    }
}
